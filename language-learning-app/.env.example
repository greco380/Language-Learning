# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify OpenAI model (default: gpt-3.5-turbo)
REACT_APP_OPENAI_MODEL=gpt-3.5-turbo

# Optional: API base URL (if using a proxy or different endpoint)
# REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1

# Application Configuration
REACT_APP_DEFAULT_LANGUAGE=Spanish
REACT_APP_MAX_RECORDING_DURATION=30000
